# Azure production/staging settings example.
# Copy values into Azure Container Apps/App Service environment variables or
# Azure Key Vault references. Do not commit real secrets.

TZ=America/Santiago
SPRING_PROFILES_ACTIVE=prod
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Public URLs
PUBLIC_FRONTEND_URL=https://styleandbeauty.me
PUBLIC_GATEWAY_URL=https://sb-gateway.bluerock-c41dfa74.brazilsouth.azurecontainerapps.io
FRONTEND_PUBLIC_URL=https://styleandbeauty.me
GATEWAY_PUBLIC_URL=https://sb-gateway.bluerock-c41dfa74.brazilsouth.azurecontainerapps.io
VITE_API_URL=https://sb-gateway.bluerock-c41dfa74.brazilsouth.azurecontainerapps.io/api
VITE_API_BASE_URL=https://sb-gateway.bluerock-c41dfa74.brazilsouth.azurecontainerapps.io
VITE_ASSETS_BASE_URL=
VITE_HOME_HERO_IMAGE_URL=https://<storage-account>.blob.core.windows.net/stylebeauty/<jefes-image-path>
VITE_USE_MOCKS=false

# Azure Blob Storage for uploaded service, staff and product images.
# Store the real connection string as an Azure secret.
AZURE_STORAGE_CONNECTION_STRING=<azure-secret>
AZURE_STORAGE_CONTAINER=stylebeauty

# Firebase Web SDK public config. These are not service-account secrets, but
# keep them in environment variables so each environment is explicit.
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
VITE_FIREBASE_APP_ID=<firebase-web-app-id>

# CORS. Include local origins only in dev/staging, not production.
APP_CORS_ALLOWED_ORIGINS=https://styleandbeauty.me,https://www.styleandbeauty.me,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://styleandbeauty.me,https://www.styleandbeauty.me,http://localhost:5173

# Internal service URLs. In Azure Container Apps use internal ingress FQDNs or
# service discovery names. In a VM/docker-compose deployment keep container
# service names.
MS_AUTH_URI=http://ms-auth:8081
MS_PERFILES_URI=http://ms-perfiles:8082
MS_CATALOGO_URI=http://ms-catalogo:8083
MS_AGENDA_URI=http://ms-agenda:8084
MS_INVENTARIO_URI=http://ms-inventario:8085
MS_PAGOS_URI=http://ms-pagos:8086
MS_EXTRA_URI=http://ms-extra:8087
MS_NOTIFICACION_AUDIT_URI=http://ms-notificacion-audit:8088
MS_PERFILES_URL=http://ms-perfiles:8082
MS_CATALOGO_URL=http://ms-catalogo:8083
MS_AGENDA_BASE_URL=http://ms-agenda:8084
MS_CATALOGO_BASE_URL=http://ms-catalogo:8083

# PostgreSQL. Recommended: Azure Database for PostgreSQL Flexible Server or
# Supabase Pooler. Put passwords in Azure secrets. If using PgBouncer/pooler,
# keep prepareThreshold=0 in the JDBC URL.
POSTGRES_DB=style_beauty
DATABASE_HOST=<postgres-host>
DATABASE_PORT=5432
DATABASE_NAME=style_beauty
DATABASE_USER=<postgres-user>
DATABASE_PASSWORD=<azure-secret>
MS_PERFILES_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
MS_CATALOGO_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
MS_AGENDA_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
MS_INVENTARIO_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
MS_PAGOS_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
MS_EXTRA_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require
MS_PERFILES_DATASOURCE_USERNAME=<postgres-user>
MS_CATALOGO_DATASOURCE_USERNAME=<postgres-user>
MS_AGENDA_DATASOURCE_USERNAME=<postgres-user>
MS_INVENTARIO_DATASOURCE_USERNAME=<postgres-user>
MS_PAGOS_DATASOURCE_USERNAME=<postgres-user>
MS_EXTRA_DATASOURCE_USERNAME=<postgres-user>
MS_PERFILES_DATASOURCE_PASSWORD=<azure-secret>
MS_CATALOGO_DATASOURCE_PASSWORD=<azure-secret>
MS_AGENDA_DATASOURCE_PASSWORD=<azure-secret>
MS_INVENTARIO_DATASOURCE_PASSWORD=<azure-secret>
MS_PAGOS_DATASOURCE_PASSWORD=<azure-secret>
MS_EXTRA_DATASOURCE_PASSWORD=<azure-secret>
SPRING_DATASOURCE_URL=jdbc:postgresql://<postgres-host>:5432/style_beauty?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=<postgres-user>
SPRING_DATASOURCE_PASSWORD=<azure-secret>

# Hikari. Keep small for Azure for Students and shared poolers.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=300000
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
SPRING_SQL_INIT_MODE=never

# WebPay. Keep real mode disabled unless valid production Transbank credentials
# are configured and tested. Return/callback URLs are derived from
# PUBLIC_GATEWAY_URL and PUBLIC_FRONTEND_URL.
WEBPAY_REAL_ENABLED=false
TBK_COMMERCE_CODE=<azure-secret>
TBK_API_KEY=<azure-secret>

# MongoDB for notification/audit service if deployed.
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<azure-secret>@<mongo-host>/<database>?retryWrites=true&w=majority
MONGO_DB=style_beauty_audit

# Firebase Admin. The previous validation key was exposed in chat and must be
# revoked. Use a newly generated service account credential only as an Azure
# secret or secure mounted file.
FIREBASE_SERVICE_ACCOUNT_JSON=<azure-secret-json-one-line>
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Calendar integration. Keep disabled until a production calendar and
# credentials are ready.
APP_AGENDA_ZONE=America/Santiago
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_FAIL_ON_ERROR=false
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=

# Basic auth defaults must be replaced with secrets if these services are public.
SPRING_SECURITY_USER_NAME=<azure-secret>
SPRING_SECURITY_USER_PASSWORD=<azure-secret>
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=<azure-secret>
N8N_BASIC_AUTH_PASSWORD=<azure-secret>

