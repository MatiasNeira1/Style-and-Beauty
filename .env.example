API_GATEWAY_PORT=8080
FRONTEND_PORT=80
POSTGRES_DB=style_beauty
POSTGRES_USER=style_beauty_app
POSTGRES_PASSWORD=replace_with_a_strong_app_password
POSTGRES_ADMIN_PASSWORD=replace_with_a_strong_admin_password
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replace_with_a_strong_replication_password
MONGO_PORT=27017
MONGO_DB=style_beauty_audit
APP_AGENDA_ZONE=America/Santiago
APP_CORS_ALLOWED_ORIGINS=https://midominio.com,https://www.midominio.com
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=always
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
TZ=America/Santiago

# Optional Firebase Admin credentials for backend services that validate tokens.
# Prefer a mounted file path in production.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_FAIL_ON_ERROR=true
GOOGLE_CALENDAR_CREDENTIALS_PATH=/run/secrets/google-calendar-service-account.json
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=
