# Docker Compose local settings. Copy to .env and replace placeholders.

POSTGRES_DB=style_beauty
POSTGRES_USER=style_beauty_app
POSTGRES_PASSWORD=change_me_app
TZ=America/Santiago

APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=300000

# Use local Postgres for full local validation, or set each MS_*_DATASOURCE_URL
# to Supabase Pooler with prepareThreshold=0 in the JDBC URL.
MS_PERFILES_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty
MS_CATALOGO_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty
MS_AGENDA_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty
MS_INVENTARIO_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty
MS_PAGOS_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty
MS_EXTRA_DATASOURCE_URL=jdbc:postgresql://postgres-master:5432/style_beauty

MS_PERFILES_DATASOURCE_USERNAME=style_beauty_app
MS_CATALOGO_DATASOURCE_USERNAME=style_beauty_app
MS_AGENDA_DATASOURCE_USERNAME=style_beauty_app
MS_INVENTARIO_DATASOURCE_USERNAME=style_beauty_app
MS_PAGOS_DATASOURCE_USERNAME=style_beauty_app
MS_EXTRA_DATASOURCE_USERNAME=style_beauty_app

MS_PERFILES_DATASOURCE_PASSWORD=change_me_app
MS_CATALOGO_DATASOURCE_PASSWORD=change_me_app
MS_AGENDA_DATASOURCE_PASSWORD=change_me_app
MS_INVENTARIO_DATASOURCE_PASSWORD=change_me_app
MS_PAGOS_DATASOURCE_PASSWORD=change_me_app
MS_EXTRA_DATASOURCE_PASSWORD=change_me_app

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_FAIL_ON_ERROR=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=

# One-line Firebase Admin service account JSON for Docker Compose.
# Do not commit real credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

API_GATEWAY_PORT=8080
FRONTEND_PORT=80
VITE_API_BASE_URL=
VITE_API_URL=http://localhost
VITE_USE_MOCKS=false
