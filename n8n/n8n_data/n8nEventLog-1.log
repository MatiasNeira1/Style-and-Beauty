:{\"lc\":1,\"type\":\"secret\",\"id\":[\"GOOGLE_API_KEY\"]},\"base_url\":\"https://generativelanguage.googleapis.com\",\"model\":\"gemini-2.5-flash\"},\"response\":{\"response\":{\"generations\":[[{\"text\":\"{\\\"intencion\\\": \\\"agendar_cita\\\", \\\"servicio\\\": \\\"limpieza facial\\\", \\\"fecha\\\": \\\"2026-05-29\\\", \\\"hora\\\": \\\"15:00\\\", \\\"idCliente\\\": \\\"5f1a7b4e-12ab-4b91-9c5a-123456789abc\\\", \\\"idServicio\\\": \\\"\\\", \\\"idStaff\\\": \\\"\\\", \\\"datosFaltantes\\\": []}\",\"generationInfo\":{\"finishReason\":\"STOP\",\"index\":0}}]]},\"tokenUsage\":{\"completionTokens\":100,\"promptTokens\":422,\"totalTokens\":522}}}"}}
